#include <iostream>
using namespace std;

template <class T>
void swapValues(T &a, T &b)
{
    T temp;
    temp = a;
    a = b;
    b = temp;
}

int main()
{
    int x = 10, y = 20;
    cout << "Before swapping: " << x << " " << y << endl;
    swapValues(x, y);
    cout << "After swapping: " << x << " " << y << endl;

    float a = 2.5, b = 5.5;
    cout << "\nBefore swapping: " << a << " " << b << endl;
    swapValues(a, b);
    cout << "After swapping: " << a << " " << b << endl;

    char c = 'A', d = 'B';
    cout << "\nBefore swapping: " << c << " " << d << endl;
    swapValues(c, d);
    cout << "After swapping: " << c << " " << d << endl;

    return 0;
}
