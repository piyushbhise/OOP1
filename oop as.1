#include<iostream>
using namespace std;
class book
{
public:
int id;
float price;

void input()
{
cout<<"ENTER BOOK ID: "<<endl;
cin>>id;

cout<<"ENTER BOOK PRICE: "<<endl;
cin>>price;
}
void display()
{
cout<<"BOOK ID IS : " << id << endl;
cout<<"BOOK PRICE IS : " << price << endl;
}

};
int main()
{
book b1,b2;

b1.input();
b1.display();

b2.input();
b2.display();

return 0;
}
